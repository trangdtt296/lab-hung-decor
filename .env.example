# Biến môi trường Firebase (Bắt buộc dùng tiền tố NEXT_PUBLIC_ cho Client Components)
# Copy file này thành .env.local và điền cấu hình từ Firebase Console của bạn
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=lab-hung-decor.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=lab-hung-decor
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=lab-hung-decor.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Firebase Admin SDK — CHỈ dùng phía server cho API phiếu lương nhân viên (/api/payslip/...).
# KHÔNG thêm tiền tố NEXT_PUBLIC_ (để không lộ ra trình duyệt).
# Lấy từ: Firebase Console → Project settings → Service accounts → Generate new private key
# (mở file JSON tải về, copy "client_email" và "private_key"; giữ nguyên các ký tự \n trong private key).
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@lab-hung-decor.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
